# Modules JavaScript .mjs (pdf.js, /node_modules/pdfjs-dist) : les navigateurs refusent de les exécuter
# s'ils ne sont pas servis comme JavaScript (anciennes configurations d'Apache sans ce type).
<IfModule mod_mime.c>
    AddType text/javascript .mjs
</IfModule>

# Fichiers du projet qui ne doivent pas être lisibles depuis le web :
# dump et migrations SQL (schéma de la base), documentation, configuration de Composer / npm / PostCSS, journaux
<FilesMatch "(\.(sql|md|lock|log)|^composer\.json|^package\.json|^package-lock\.json|^postcss\.config\.js|^\.gitignore)$">
    Require all denied
</FilesMatch>

# Dépôt git (si le site est déployé avec git clone / git pull)
RedirectMatch 404 /\.git(/|$)

# CSS et JavaScript : le navigateur garde sa copie mais demande au serveur si elle est à jour avant de la réutiliser
# (réponse 304 sans contenu si rien n'a changé). Évite qu'un ancien script ou style soit utilisé après une mise à jour,
# y compris pour les modules importés par d'autres modules (sans ?v=, voir config/assets.php).
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
